# ==============================================================================
# Shafed Billi - Environment Configuration Template
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Configuration
# ------------------------------------------------------------------------------
# Discord bot application token (from https://discord.com/developers/applications)
# Required privileged intents: Server Members, Presence, Message Content
BOT_TOKEN=your_discord_bot_token_here

# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/shafed-billi

# Comma-separated Discord User IDs of bot owners/developers
OWNER_IDS=your_discord_user_id

# ------------------------------------------------------------------------------
# Bot Settings
# ------------------------------------------------------------------------------
# Default command prefix for text commands
BOT_PREFIX=.

# Default embed hex color code
BOT_COLOR=#3F4652

# Logging level: info, warn, error, debug
LOG_LEVEL=info

# Set to true to enable detailed voice-connection debug logging
DEBUG_VOICE=false

# ------------------------------------------------------------------------------
# Lavalink Configuration
# ------------------------------------------------------------------------------
# Identifier name for the Lavalink node
LAVALINK_NAME=Primary

# Lavalink host and port (e.g. localhost:2333 or IP:PORT)
LAVALINK_URL=localhost:2333

# Password / auth secret configured in Lavalink application.yml
LAVALINK_PASSWORD=youshallnotpass

# Set to true if using SSL/TLS (wss:// / https://)
LAVALINK_SECURE=false

# Default search provider / source platform (e.g. ytmsearch, ytsearch, scsearch, spsearch)
LAVALINK_SOURCE=ytmsearch

# ------------------------------------------------------------------------------
# Spotify Integration (Optional)
# ------------------------------------------------------------------------------
# Spotify application credentials (from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Links & Community Information (Optional)
# ------------------------------------------------------------------------------
# Image URL for embed backgrounds / card banners
BACKGROUND_URL=

# Support server invite URL
SUPPORT_URL=

# Bot invite link
INVITE_URL=

# Vanity invite link / custom URL
VANITY_URL=

# Primary community Discord Guild (Server) ID
COMMUNITY_GUILD_ID=

# ------------------------------------------------------------------------------
# Webhook Logging (Optional)
# Discord webhook URLs for tracking bot activity and alerts
# ------------------------------------------------------------------------------
BLACKLIST_WEBHOOK_URL=
PLAYER_CREATE_WEBHOOK_URL=
PLAYER_DELETE_WEBHOOK_URL=
GUILD_JOIN_WEBHOOK_URL=
GUILD_LEAVE_WEBHOOK_URL=
COMMAND_WEBHOOK_URL=
